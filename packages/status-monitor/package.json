{
  "name": "@philomelcc/dsh-status-monitor",
  "version": "0.1.0",
  "type": "module",
  "description": "Status monitor view for the DSH workbench: disk, hardware, ports and usage cards with a full-page zoom.",
  "license": "MIT",
  "author": "philomelcc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philomelcc/dsh-workbench.git",
    "directory": "packages/status-monitor"
  },
  "homepage": "https://github.com/philomelcc/dsh-workbench#readme",
  "bugs": {
    "url": "https://github.com/philomelcc/dsh-workbench/issues"
  },
  "keywords": ["dsh", "deepseek-harness", "workbench", "status-monitor", "plugin"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
