{
  "name": "@philomelcc/dsh-downloads",
  "version": "0.1.2",
  "type": "module",
  "description": "Download manager for the DSH workbench: task queue with progress, pause and resume, and a per-session history.",
  "license": "MIT",
  "author": "philomelcc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philomelcc/dsh-workbench.git",
    "directory": "packages/download-center"
  },
  "homepage": "https://github.com/philomelcc/dsh-workbench#readme",
  "bugs": {
    "url": "https://github.com/philomelcc/dsh-workbench/issues"
  },
  "keywords": ["dsh", "deepseek-harness", "workbench", "download-manager"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "chrome-extension",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
